# OmniMind environment variables
# Copy relevant sections to apps/api/.env.local and apps/web/.env.local
# Never commit .env.local files to version control

# ============================================
# apps/api/.env.local
# ============================================

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Clerk secret key (from clerk.com → API Keys)
CLERK_SECRET_KEY=sk_test_...

# Frontend origin for CORS and Clerk authorizedParties
ALLOWED_ORIGIN=http://localhost:3000

# AES-256-GCM key for provider key encryption — must be exactly 64 hex chars (32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROVIDER_KEY_ENCRYPTION_SECRET=change-me-to-64-hex-chars

# Optional overrides
PORT=3001
NODE_ENV=development

# --------------------------------------------
# Cloudflare R2 object storage (M7 file pipeline)
# REQUIRED since M7B: the API issues real signed URLs and verifies uploads
# against R2 at boot-validated config (see ADR 0007). Copy to
# apps/api/.env.local with real values; never commit that file.
# R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
# R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_BUCKET=omnimind-files
# R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# ============================================
# apps/web/.env.local
# ============================================

# Clerk publishable key (from clerk.com → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:3001
