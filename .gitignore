# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# environment variables
.env
.env*.local

# dependencies
node_modules

# lockfiles from non-canonical package managers
# bun.lock is the legacy lockfile; pnpm-lock.yaml is the v2 canonical lockfile
bun.lock

# testing
coverage

# next.js
.next/
out/

# build outputs
build
dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# vercel
.vercel

# typescript incremental build info
*.tsbuildinfo
next-env.d.ts

# turbo
.turbo

# Claude Code settings
.claude/
